# ============================================================================
# Insider Trading Report Service — Environment Variables
# ============================================================================
# Copy to .env for local runs; set the same keys in the Railway dashboard.
# Every value below is a PLACEHOLDER — never commit real secrets.
# ============================================================================

# ── Clerk (authentication) ──────────────────────────────────────────────────
# Must be the SAME Clerk application as the trading_agents and report-suite
# services, so all of them see the same user IDs and the same credit wallet.
CLERK_JWKS_URL=https://clerk.your-domain.com/.well-known/jwks.json

# ── Shared Postgres (credits) ───────────────────────────────────────────────
# On Railway, reference the Postgres service variable rather than pasting a
# literal URL:  DATABASE_URL=${{Postgres.DATABASE_URL}}
# Leave unset locally to fall back to SQLite.
DATABASE_URL=

# ── Cloudflare R2 (report storage) ──────────────────────────────────────────
# The bucket is shared with the other services. This one only ever writes
# under the R2_PREFIX below, so nothing can collide.
R2_ACCOUNT_ID=your_account_id
R2_ACCESS_KEY_ID=your_access_key_id
R2_SECRET_ACCESS_KEY=your_secret_access_key
R2_BUCKET_NAME=tradingagents
R2_PREFIX=insider

# ── Admin endpoints ─────────────────────────────────────────────────────────
# Protects /api/admin/*. Generate a long random string:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_SECRET_KEY=change-me

# ── Frontend / CORS ─────────────────────────────────────────────────────────
FRONTEND_URL=https://your-domain.com
# Optional comma-separated extras (preview deploys, apex vs www, etc.)
EXTRA_CORS_ORIGINS=

# ── Storage paths (defaults match the Railway volume) ───────────────────────
DATA_DIR=/data

# ── SEC EDGAR ───────────────────────────────────────────────────────────────
# SEC REQUIRES a declared User-Agent carrying a real contact address, and
# refuses requests without one. Put a real address here — this is the only
# setting whose default you should genuinely change.
SEC_USER_AGENT=Your Company insider-research you@example.com

# SEC's published limit is 10 requests/second. 8 leaves retry headroom.
SEC_RATE_PER_SECOND=8.0
SEC_WORKERS=8

# Calendar days of daily filing indexes a routine run re-scans. Form 4 is due
# within two business days, so a week comfortably covers late and amended
# filings. Already-downloaded filings are skipped, so the overlap is cheap.
SEC_LOOKBACK_DAYS=7

# Quarters of bulk history to load when the store is cold. Each is a ~10MB
# ZIP that parses in about a second.
SEC_BACKFILL_QUARTERS=10

# Trading days of the bulk-to-daily gap to close per build. SEC publishes the
# quarterly datasets in arrears, so a fresh store has a hole of up to five
# months between them and the daily window. Each build closes a chunk,
# oldest first, so the first report is available immediately and the history
# completes over the following few days.
SEC_GAP_DAYS_PER_RUN=45

# ── Report content ──────────────────────────────────────────────────────────
# Minimum absolute transaction value to store, in dollars.
MIN_TRADE_VALUE=1000000
# Days the daily report's headline window covers.
LOOKBACK_DAYS=10
# How far back the cluster section reaches. 0 means no limit.
CLUSTER_LOOKBACK_DAYS=540
# Insiders who must buy the same ticker on the same day to form a cluster.
MIN_CLUSTER_INSIDERS=2
MIN_CLUSTER_VALUE_PER_INSIDER=1000000

# ── Pricing ─────────────────────────────────────────────────────────────────
# Credits charged for one briefing.
REPORT_CREDIT_COST=1

# ── Build schedule ──────────────────────────────────────────────────────────
# Hour (UTC) for the daily refresh + rebuild. 11 == ~7am ET: the previous
# session's Form 4 filings have settled (EDGAR's cutoff is 10pm ET), and it
# is eleven hours clear of the price-data service's 22:00 UTC build.
BUILD_HOUR_UTC=11

# Hours (UTC) in which this service will NOT start a fetching build, because
# the price-data service may be running. Separate build hours already keep
# the scheduled runs apart; this closes the other doors — BUILD_ON_BOOT
# firing during a redeploy, an admin rebuild, or a run that overruns.
# Only Yahoo Finance is actually shared (this service uses it for chart
# price series only); SEC EDGAR is not contended at all.
QUIET_HOURS_UTC=21,22,23

# How often the scheduler checks whether a build is due.
SCHEDULER_POLL_SECONDS=300
# Ceiling on a single build.
BUILD_TIMEOUT_SECONDS=3600
# Build on startup if no report is ready. Set false for API-only local work.
BUILD_ON_BOOT=true
# Run the scheduler at all. Must be false on every replica but one.
SCHEDULER_ENABLED=true

# ── Downloads ───────────────────────────────────────────────────────────────
# Lifetime of the presigned R2 links handed to the browser.
DOWNLOAD_URL_TTL_SECONDS=3600
